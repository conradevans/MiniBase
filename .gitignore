/minibase
/coverage.out

# Frontend output and dependencies
/frontend/node_modules/
/frontend/dist/
/frontend/coverage/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
tmp/
.cache/

# Editor / OS
.DS_Store
.vscode/
